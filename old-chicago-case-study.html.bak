<title>One Platform, Every Pour</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap">
<style>
  :root{
    --bg:#f7f4ec;
    --bg-panel:#ffffff;
    --bg-panel-2:#eef1ec;
    --text:#1c2b38;
    --text-dim:#5f6c74;
    --accent:#24486a;
    --pop:#b81828;
    --line:#dde2de;
    --hero-scrim:16,14,10;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:"Inter",system-ui,sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .display{
    font-family:"Oswald",sans-serif;
    font-weight:700;
    line-height:1.12;
    letter-spacing:-.005em;
  }
  .display em{ font-style:normal; color:var(--pop); }
  .display em.pop{ color:var(--pop); }
  .kicker{
    font-family:"Inter",sans-serif;
    font-weight:700;
    letter-spacing:.16em;
    text-transform:uppercase;
    font-size:12px;
    color:var(--accent);
  }
  .card{
    background:var(--bg-panel);
    border:1px solid var(--line);
    border-radius:6px;
  }
  .tag{
    font-size:13px;
    font-weight:600;
    padding:8px 16px;
    border-radius:999px;
    border:1px solid var(--line);
    background:var(--bg-panel);
    color:var(--text-dim);
    white-space:nowrap;
  }
  :focus-visible{ outline:2px solid var(--accent); outline-offset:3px; }

  .page{ display:flex; flex-direction:column; }

  /* ===== top bar ===== */
  .topbar{
    display:flex; align-items:center; justify-content:space-between;
    padding:26px clamp(20px,6vw,64px);
    border-bottom:1px solid var(--line);
  }
  .topbar .meta{ font-size:12px; letter-spacing:.1em; text-transform:uppercase; color:var(--text-dim); font-weight:600; }

  /* ===== hero ===== */
  .hero{
    position:relative;
    overflow:hidden;
    min-height:min(520px,74svh);
    display:flex;
    align-items:center;
    padding:clamp(56px,10vw,96px) clamp(20px,6vw,64px) clamp(64px,10vw,100px);
    background-image:url("data:image/jpeg;base64,");
    background-size:cover;
    background-position:center 58%;
  }
  .hero::before{
    content:""; position:absolute; inset:0;
    background:linear-gradient(100deg, rgba(var(--hero-scrim),.86) 0%, rgba(var(--hero-scrim),.56) 40%, rgba(var(--hero-scrim),.18) 68%, rgba(var(--hero-scrim),.4) 100%);
  }
  .hero::after{
    content:""; position:absolute; inset:0;
    background:linear-gradient(180deg, var(--bg) 0%, rgba(var(--hero-scrim),0) 14%, rgba(var(--hero-scrim),0) 84%, var(--bg) 100%);
  }
  .hero-inner{ position:relative; max-width:600px; }
  .hero-logo{ height:34px; margin-bottom:20px; filter:drop-shadow(0 2px 6px rgba(0,0,0,.4)); }
  .hero-inner .kicker{ margin-bottom:18px; color:#f2d9a8; }
  .hero-inner h1{ font-size:clamp(2.2rem,5vw,3.8rem); margin:0 0 26px; color:#ffffff; text-wrap:balance; }
  .hero-inner p{ font-size:clamp(1rem,1.5vw,1.1rem); line-height:1.65; color:rgba(255,255,255,.9); max-width:500px; margin:0; }

  .rule{ height:3px; background:linear-gradient(90deg, var(--pop), var(--accent)); }

  /* ===== scattered menus -> one platform ===== */
  .consolidate{
    display:flex; align-items:center; justify-content:center; gap:clamp(14px,3vw,32px);
    flex-wrap:wrap;
    padding:34px clamp(20px,6vw,64px);
    background:var(--bg-panel-2);
    border-bottom:1px solid var(--line);
  }
  .platform-stack{ display:flex; flex-direction:column; gap:8px; }
  .platform-pill{
    font-size:12px; font-weight:600; color:var(--text-dim);
    border:1px solid var(--line); border-radius:999px;
    background:var(--bg-panel);
    padding:6px 14px; text-align:center;
  }
  .consolidate-arrow{ color:var(--pop); font-size:1.4rem; }
  .app-box{
    font-family:"Oswald",sans-serif;
    font-weight:700; font-size:clamp(1rem,2vw,1.3rem);
    color:#ffffff; background:var(--accent);
    border-radius:8px;
    padding:20px 30px;
    text-align:center;
  }

  /* ===== challenge ===== */
  .challenge{
    padding:clamp(48px,8vw,64px) clamp(20px,6vw,64px) clamp(56px,8vw,72px);
    display:flex; gap:48px; flex-wrap:wrap; justify-content:center;
  }
  .challenge .label{ flex:0 0 auto; }
  .challenge p{ flex:1 1 620px; max-width:720px; font-size:clamp(1.05rem,1.8vw,1.3rem); line-height:1.65; color:var(--text); margin:0; font-weight:500; }

  /* ===== my role ===== */
  .role{ padding:clamp(56px,9vw,72px) clamp(20px,6vw,64px); border-top:1px solid var(--line); }
  .role-head{ text-align:center; margin-bottom:36px; }
  .role-head .kicker{ margin-bottom:14px; }
  .role-head h2{ font-size:clamp(1.7rem,3.4vw,2.6rem); margin:0 0 20px; color:var(--text); }
  .role-tags{ display:flex; gap:12px; justify-content:center; flex-wrap:wrap; margin-bottom:18px; }
  .role-tags .tag{ color:var(--accent); border-color:var(--accent); }
  .role-head .sub{ max-width:600px; margin:0 auto; color:var(--text-dim); font-size:16px; line-height:1.6; }

  .steps{
    display:grid;
    grid-template-columns:repeat(4, minmax(0,1fr));
    gap:16px;
    max-width:1120px;
    margin:0 auto;
  }
  @media (max-width:900px){ .steps{ grid-template-columns:repeat(2, minmax(0,1fr)); } }
  @media (max-width:520px){ .steps{ grid-template-columns:1fr; } }
  .steps .card{ padding:22px; }
  .steps .num{ font-size:12px; font-weight:700; letter-spacing:.08em; color:var(--accent); margin-bottom:10px; font-variant-numeric:tabular-nums; }
  .steps .title{ font-weight:700; font-size:16px; margin-bottom:8px; }
  .steps .desc{ font-size:14px; line-height:1.55; color:var(--text-dim); }

  /* ===== skills ===== */
  .skills{ padding:clamp(56px,9vw,72px) clamp(20px,6vw,64px); border-top:1px solid var(--line); text-align:center; }
  .skills .kicker{ margin-bottom:14px; display:block; }
  .skills h2{ font-size:clamp(1.6rem,3vw,2.2rem); margin:0 0 30px; color:var(--text); }
  .skill-tags{ display:flex; gap:10px; flex-wrap:wrap; justify-content:center; max-width:880px; margin:0 auto; }

  /* ===== closing ===== */
  .closing{
    position:relative; padding:clamp(64px,11vw,96px) clamp(20px,6vw,64px);
    border-top:1px solid var(--line); overflow:hidden;
    background:radial-gradient(ellipse 70% 120% at 50% 40%, var(--bg-panel-2) 0%, var(--bg) 72%);
  }
  .closing-inner{ position:relative; text-align:center; max-width:680px; margin:0 auto; }
  .closing h2{ font-size:clamp(2.1rem,4.6vw,3.3rem); margin:0 0 18px; color:var(--text); }
  .closing p{ font-size:16px; line-height:1.6; color:var(--text-dim); margin:0; }

  /* ===== footer ===== */
  footer{
    padding:24px clamp(20px,6vw,64px);
    border-top:1px solid var(--line);
    display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px;
    font-size:12px; color:var(--text-dim);
  }

  /* ===== gallery ===== */
  .gal-section{ padding:clamp(56px,9vw,72px) clamp(20px,6vw,64px); border-top:1px solid var(--line); text-align:center; }
  .gal-section .kicker{ margin-bottom:14px; display:block; }
  .gal-section h2{ font-size:clamp(1.6rem,3vw,2.2rem); margin:0 0 12px; color:var(--text); }
  .gal-sub{ color:var(--text-dim); font-size:14px; margin:0 0 36px; }

  .gal-grid{
    display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:16px;
    max-width:1120px; margin:0 auto; text-align:left;
  }
  @media (max-width:900px){ .gal-grid{ grid-template-columns:repeat(2, minmax(0,1fr)); } }
  @media (max-width:520px){ .gal-grid{ grid-template-columns:1fr; } }

  .gal-item{
    all:unset; cursor:pointer; display:block;
    background:var(--bg-panel); border:1px solid var(--line); border-radius:8px; overflow:hidden;
    transition:transform .3s cubic-bezier(.16,1,.3,1), border-color .3s ease, box-shadow .3s ease;
  }
  .gal-item:hover, .gal-item:focus-visible{
    transform:translateY(-4px); border-color:var(--accent); box-shadow:0 16px 32px -20px rgba(20,30,40,.25);
  }
  .gal-item:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; }

  .gal-thumb{
    aspect-ratio:4/3; position:relative;
    background:repeating-linear-gradient(135deg, transparent 0 8px, var(--line) 8px 9px);
    display:flex; align-items:center; justify-content:center; overflow:hidden;
  }
  .gal-thumb img{ width:100%; height:100%; object-fit:cover; display:block; }
  .gal-placeholder-mark{
    font-family:ui-monospace,"SFMono-Regular",Consolas,monospace;
    font-size:10.5px; letter-spacing:.08em; text-transform:uppercase;
    color:var(--text-dim); background:var(--bg); border:1px solid var(--line); border-radius:999px; padding:4px 10px;
  }
  .gal-cap{ padding:14px 16px 16px; }
  .gal-cap-title{ display:block; font-weight:700; font-size:14px; color:var(--text); margin-bottom:4px; }
  .gal-cap-desc{ display:block; font-size:12.5px; line-height:1.5; color:var(--text-dim); }

  .gal-lightbox{
    position:fixed; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center;
    padding:5vh 4vw; background:rgba(15,20,25,.72); opacity:0; pointer-events:none; transition:opacity .25s ease;
  }
  .gal-lightbox.is-open{ opacity:1; pointer-events:auto; }
  .gal-lightbox-dialog{
    position:relative; max-width:min(920px,92vw); width:100%;
    background:var(--bg-panel); border:1px solid var(--line); border-radius:10px; overflow:hidden;
    transform:scale(.96) translateY(10px); transition:transform .3s cubic-bezier(.16,1,.3,1);
  }
  .gal-lightbox.is-open .gal-lightbox-dialog{ transform:scale(1) translateY(0); }
  .gal-lightbox-frame{
    aspect-ratio:16/10; position:relative; display:flex; align-items:center; justify-content:center;
    background:repeating-linear-gradient(135deg, transparent 0 8px, var(--line) 8px 9px);
  }
  .gal-lightbox-frame img{ width:100%; height:100%; object-fit:cover; display:none; position:absolute; inset:0; }
  .gal-lightbox-placeholder{
    font-family:ui-monospace,"SFMono-Regular",Consolas,monospace;
    font-size:12px; letter-spacing:.06em; text-transform:uppercase;
    color:var(--text-dim); background:var(--bg); border:1px solid var(--line); border-radius:999px; padding:6px 14px;
  }
  .gal-lightbox-meta{
    display:flex; align-items:center; justify-content:space-between; gap:16px;
    padding:16px 20px; border-top:1px solid var(--line);
  }
  .gal-lightbox-meta .gal-cap-title{ font-size:15px; }
  .gal-lightbox-counter{
    font-family:ui-monospace,"SFMono-Regular",Consolas,monospace; font-size:12px; color:var(--text-dim); white-space:nowrap;
  }
  .gal-lightbox-close, .gal-lightbox-nav{
    position:absolute; width:38px; height:38px; border-radius:50%;
    border:1px solid var(--line); background:var(--bg); color:var(--text);
    display:flex; align-items:center; justify-content:center; cursor:pointer;
    transition:background .15s ease, transform .15s ease, border-color .15s ease, color .15s ease;
    font-size:18px; line-height:1;
  }
  .gal-lightbox-close{ top:12px; right:12px; z-index:2; }
  .gal-lightbox-nav{ top:50%; transform:translateY(-50%); z-index:2; }
  .gal-lightbox-prev{ left:12px; }
  .gal-lightbox-next{ right:12px; }
  .gal-lightbox-close:hover, .gal-lightbox-nav:hover:not(:disabled){ border-color:var(--accent); color:var(--accent); }
  .gal-lightbox-nav:disabled{ opacity:.3; cursor:not-allowed; }
  @media (max-width:640px){ .gal-lightbox-dialog{ max-width:94vw; } }

  /* ===== before / after compare slider ===== */
  .compare-block{ max-width:640px; margin:44px auto 0; }
  .compare-label{ font-size:13px; font-weight:700; color:var(--text); margin-bottom:14px; }
  .compare-label .desc{ display:block; font-weight:400; font-size:12.5px; color:var(--text-dim); margin-top:4px; }
  .compare-media{
    position:relative; margin:0 auto; aspect-ratio:640/400; border-radius:10px; overflow:hidden;
    border:1px solid var(--line); box-shadow:0 20px 44px -26px rgba(20,20,20,.35);
    cursor:ew-resize; touch-action:none;
  }
  .compare-img{
    position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;
    pointer-events:none; user-select:none; -webkit-user-drag:none;
  }
  .compare-after{ clip-path:inset(0 0 0 50%); will-change:clip-path; }
  .compare-handle{
    position:absolute; top:0; bottom:0; left:50%; width:0; transform:translateX(-50%); pointer-events:none;
  }
  .compare-handle::before{
    content:""; position:absolute; top:0; bottom:0; left:0; width:2px; background:#fff;
    transform:translateX(-50%); box-shadow:0 0 0 1px rgba(0,0,0,.15);
  }
  .compare-handle::after{
    content:"\2194"; position:absolute; top:50%; left:0; transform:translate(-50%,-50%);
    width:38px; height:38px; border-radius:50%; background:#fff; color:var(--accent);
    display:flex; align-items:center; justify-content:center; font-size:16px; font-weight:700;
    box-shadow:0 6px 16px -4px rgba(0,0,0,.35);
  }
  .compare-tag{
    position:absolute; top:12px; z-index:2;
    font-family:"Inter",sans-serif; font-size:10.5px; font-weight:700; letter-spacing:.08em; text-transform:uppercase;
    color:#fff; background:rgba(20,20,20,.55); border-radius:999px; padding:5px 12px;
  }
  .compare-tag-before{ left:12px; }
  .compare-tag-after{ right:12px; }
</style>

<div class="page">

  <div class="topbar">
    <div class="kicker">Portfolio Case Study</div>
    <div class="meta">Restaurant &amp; Hospitality</div>
  </div>

  <div class="hero">
    <div class="hero-inner">
      <img class="hero-logo" src="data:image/png;base64," alt="Old Chicago Pizza &amp; Taproom" />
      <div class="kicker">Old Chicago Pizza &amp; Taproom &middot; Website Redesign</div>
      <h1 class="display">One platform.<br>Every <em>pour</em>, organized.</h1>
      <p>Beer, food, rewards, and locations each lived by their own rules online. The Rock Bottom Brewery and Old Chicago Restaurant redesigns needed one information architecture that could hold all of it &mdash; and still feel like a taproom.</p>
    </div>
  </div>
  <div class="rule"></div>

  <div class="consolidate">
    <div class="platform-stack">
      <div class="platform-pill">Beer</div>
      <div class="platform-pill">Food</div>
      <div class="platform-pill">OC Rewards</div>
      <div class="platform-pill">Locations</div>
    </div>
    <div class="consolidate-arrow">&rarr;</div>
    <div class="app-box">One Redesigned Site</div>
  </div>

  <div class="challenge">
    <div class="label"><div class="kicker">The Challenge</div></div>
    <p>Rock Bottom Brewery and Old Chicago Restaurant each ran on years of accumulated menus, promotions, and loyalty mechanics with no shared structure between beer, food, rewards, and location content. Both redesigns needed a product taxonomy and content model that guests and franchisees could actually navigate.</p>
  </div>

  <div class="role">
    <div class="role-head">
      <div class="kicker">My Role</div>
      <h2 class="display">Organizing the menu behind the menu.</h2>
      <div class="role-tags">
        <span class="tag">Lead Information Architect</span>
        <span class="tag">UX Designer</span>
      </div>
      <p class="sub">I owned the information architecture and user experience across both the Rock Bottom Brewery and Old Chicago Restaurant website redesign projects.</p>
    </div>

    <div class="steps">
      <div class="card"><div class="num">01</div><div class="title">Product Classification</div><div class="desc">Developed a detailed product grouping and classification system based on users' needs across the beer and food menus.</div></div>
      <div class="card"><div class="num">02</div><div class="title">Content Inventory</div><div class="desc">Performed a content inventory across both properties ahead of migration.</div></div>
      <div class="card"><div class="num">03</div><div class="title">Migration Strategy</div><div class="desc">Facilitated migration strategy sessions to ensure content was organized and transitioned successfully.</div></div>
      <div class="card"><div class="num">04</div><div class="title">Content Audit &amp; Taxonomy</div><div class="desc">Performed a comprehensive product and services content audit and organized it into a user-centric taxonomy.</div></div>
      <div class="card"><div class="num">05</div><div class="title">Stakeholder Requirements</div><div class="desc">Facilitated requirements-gathering sessions with business stakeholders across both brands.</div></div>
      <div class="card"><div class="num">06</div><div class="title">Sitemaps &amp; Wireframes</div><div class="desc">Built highly detailed sitemaps and wireframes from those requirements.</div></div>
      <div class="card"><div class="num">07</div><div class="title">Persona Development</div><div class="desc">Executed an extensive persona process to ground design decisions in real guest behavior.</div></div>
      <div class="card"><div class="num">08</div><div class="title">Cross-Brand IA</div><div class="desc">Aligned information architecture across both the Rock Bottom Brewery and Old Chicago Restaurant redesigns.</div></div>
    </div>
  </div>

  <div class="gal-section">
    <span class="kicker">Selected Screens</span>
    <h2 class="display">The application</h2>
    <p class="gal-sub">Click a screen to enlarge.</p>
    <div class="gal-grid" id="galGrid">

      <button type="button" class="gal-item" data-index="0">
        <span class="gal-thumb"><img src="data:image/jpeg;base64," alt="Old Chicago OC Rewards page" /></span>
        <span class="gal-cap">
          <span class="gal-cap-title">OC Rewards Page</span>
          <span class="gal-cap-desc">The shipped OC Rewards page &mdash; loyalty perks, tour milestones, and sign-up brought into one taxonomy-driven flow.</span>
        </span>
      </button>

      <button type="button" class="gal-item" data-index="1">
        <span class="gal-thumb"><img src="data:image/gif;base64," alt="Wood-fired pizza baking" /></span>
        <span class="gal-cap">
          <span class="gal-cap-title">Wood-Fired, Always</span>
          <span class="gal-cap-desc">Product photography from the food taxonomy, used across menu and marketing content.</span>
        </span>
      </button>

      <button type="button" class="gal-item" data-index="2">
        <span class="gal-thumb"><img src="data:image/jpeg;base64," alt="Reclaimed wood texture" /></span>
        <span class="gal-cap">
          <span class="gal-cap-title">Brand Texture &mdash; Reclaimed Oak</span>
          <span class="gal-cap-desc">One of the material textures pulled into the redesign's visual language.</span>
        </span>
      </button>

      <button type="button" class="gal-item" data-index="3">
        <span class="gal-thumb"><span class="gal-placeholder-mark">Preview 04</span></span>
        <span class="gal-cap">
          <span class="gal-cap-title">Menu &amp; Beer Finder</span>
          <span class="gal-cap-desc">A taxonomy-driven menu and beer finder, organized around how guests actually order.</span>
        </span>
      </button>

    </div>

    <div class="compare-block">
      <div class="compare-label">Tap Wall Photography<span class="desc">Drag to compare: raw event photography, graded to match the redesigned brand system.</span></div>
      <div class="compare-media" id="compareMedia" role="slider" aria-label="Before and after photography grading" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0">
        <img class="compare-img compare-before" src="data:image/jpeg;base64," alt="Tap wall photography, before brand grading" />
        <img class="compare-img compare-after" id="compareAfter" src="data:image/jpeg;base64," alt="Tap wall photography, after brand grading" />
        <span class="compare-tag compare-tag-before">Before</span>
        <span class="compare-tag compare-tag-after">After</span>
        <div class="compare-handle" id="compareHandle"></div>
      </div>
    </div>
  </div>

  <div class="gal-lightbox" id="galLightbox" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="galLightboxTitle">
    <div class="gal-lightbox-dialog">
      <button type="button" class="gal-lightbox-close" id="galLightboxClose" aria-label="Close">&times;</button>
      <button type="button" class="gal-lightbox-nav gal-lightbox-prev" id="galLightboxPrev" aria-label="Previous screen">&larr;</button>
      <button type="button" class="gal-lightbox-nav gal-lightbox-next" id="galLightboxNext" aria-label="Next screen">&rarr;</button>
      <div class="gal-lightbox-frame">
        <img id="galLightboxImg" src="" alt="" />
        <span class="gal-lightbox-placeholder" id="galLightboxPlaceholder">Screen preview coming soon</span>
      </div>
      <div class="gal-lightbox-meta">
        <div>
          <span class="gal-cap-title" id="galLightboxTitle"></span><br>
          <span class="gal-cap-desc" id="galLightboxDesc"></span>
        </div>
        <span class="gal-lightbox-counter" id="galLightboxCounter"></span>
      </div>
    </div>
  </div>

  <div class="skills">
    <span class="kicker">Skills &amp; Technologies</span>
    <h2 class="display">The toolkit behind it</h2>
    <div class="skill-tags">
      <span class="tag">Business Requirements</span>
      <span class="tag">Functional Specifications</span>
      <span class="tag">Wireframes</span>
      <span class="tag">Storyboards</span>
      <span class="tag">Hi/Lo-Fidelity Prototyping</span>
      <span class="tag">Use-Case &amp; Scenarios</span>
      <span class="tag">Sitemaps</span>
      <span class="tag">Taxonomies</span>
      <span class="tag">SEO</span>
      <span class="tag">Persona Development</span>
    </div>
  </div>

  <div class="closing">
    <div class="closing-inner">
      <h2 class="display">One taxonomy.<br>Every <em class="pop">pour</em>, in its place.</h2>
      <p>Two brands, one information architecture &mdash; built from a real content inventory, a real persona process, and a taxonomy guests and franchisees can both actually use.</p>
    </div>
  </div>

  <footer>
    <div>Old Chicago Pizza &amp; Taproom &middot; Rock Bottom Brewery</div>
    <div>Information Architecture &middot; UX Design</div>
  </footer>
</div>

<script>
  (function(){
    var items = Array.prototype.slice.call(document.querySelectorAll('#galGrid .gal-item'));
    if (!items.length) return;
    var lightbox = document.getElementById('galLightbox');
    var imgEl = document.getElementById('galLightboxImg');
    var placeholderEl = document.getElementById('galLightboxPlaceholder');
    var titleEl = document.getElementById('galLightboxTitle');
    var descEl = document.getElementById('galLightboxDesc');
    var counterEl = document.getElementById('galLightboxCounter');
    var closeBtn = document.getElementById('galLightboxClose');
    var prevBtn = document.getElementById('galLightboxPrev');
    var nextBtn = document.getElementById('galLightboxNext');
    var current = 0;
    var lastFocused = null;

    function render(){
      var el = items[current];
      var title = el.querySelector('.gal-cap-title').textContent;
      var desc = el.querySelector('.gal-cap-desc').textContent;
      var srcImg = el.querySelector('img');
      if (srcImg) {
        imgEl.src = srcImg.currentSrc || srcImg.src;
        imgEl.alt = srcImg.alt || title;
        imgEl.style.display = 'block';
        placeholderEl.style.display = 'none';
      } else {
        imgEl.removeAttribute('src');
        imgEl.style.display = 'none';
        placeholderEl.style.display = 'flex';
      }
      titleEl.textContent = title;
      descEl.textContent = desc;
      counterEl.textContent = (current + 1) + ' / ' + items.length;
      prevBtn.disabled = current === 0;
      nextBtn.disabled = current === items.length - 1;
    }
    function open(index){
      current = index;
      lastFocused = document.activeElement;
      render();
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
      document.addEventListener('keydown', onKeydown);
    }
    function close(){
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      if (lastFocused) lastFocused.focus();
    }
    function go(delta){
      var next = current + delta;
      if (next < 0 || next >= items.length) return;
      current = next;
      render();
    }
    function onKeydown(e){
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') go(1);
      if (e.key === 'ArrowLeft') go(-1);
    }

    items.forEach(function(el, i){
      el.addEventListener('click', function(){ open(i); });
    });
    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', function(){ go(-1); });
    nextBtn.addEventListener('click', function(){ go(1); });
    lightbox.addEventListener('click', function(e){ if (e.target === lightbox) close(); });
  })();

  (function(){
    var media = document.getElementById('compareMedia');
    var afterImg = document.getElementById('compareAfter');
    var handle = document.getElementById('compareHandle');
    if (!media || !afterImg || !handle) return;
    var dragging = false;

    function setPct(pct){
      pct = Math.min(100, Math.max(0, pct));
      afterImg.style.clipPath = 'inset(0 0 0 ' + pct + '%)';
      handle.style.left = pct + '%';
      media.setAttribute('aria-valuenow', Math.round(pct));
    }
    function pctFromEvent(e){
      var rect = media.getBoundingClientRect();
      var x = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
      return (x / rect.width) * 100;
    }
    media.addEventListener('pointerdown', function(e){
      dragging = true;
      media.setPointerCapture(e.pointerId);
      setPct(pctFromEvent(e));
    });
    media.addEventListener('pointermove', function(e){
      if (!dragging) return;
      setPct(pctFromEvent(e));
    });
    media.addEventListener('pointerup', function(){ dragging = false; });
    media.addEventListener('pointercancel', function(){ dragging = false; });
    media.addEventListener('keydown', function(e){
      var current = parseFloat(media.getAttribute('aria-valuenow')) || 50;
      if (e.key === 'ArrowLeft'){ setPct(current - 5); e.preventDefault(); }
      if (e.key === 'ArrowRight'){ setPct(current + 5); e.preventDefault(); }
    });
  })();
</script>
